{
  "name": "onesmallask",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "One Small Ask - a reviewed noticeboard where one person posts one small, specific need ($5-$100) and someone who wants to help sends it to them directly. The site never touches the money.",
  "scripts": {
    "dev": "vite",
    "demo": "vite --mode demo",
    "build": "tsc --noEmit && vite build",
    "build:demo": "tsc --noEmit && vite build --mode demo",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --port 4173",
    "screen:test": "node scripts/screen.test.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "playwright": "^1.49.0",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.15",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
